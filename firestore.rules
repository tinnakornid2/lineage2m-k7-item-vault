rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function roundEnforced() {
      let path = /databases/$(database)/documents/app_settings/stat_updates;
      return exists(path) && 'round' in get(path).data && get(path).data.round.active == true
        && request.time.toMillis() >= get(path).data.round.enforceAt;
    }
    function roundEligible() {
      return !roundEnforced() || (signedIn()
        && currentProfile().data.get('approvedStatRequestAt', 0) >= get(/databases/$(database)/documents/app_settings/stat_updates).data.round.openedAt
        && currentProfile().data.get('statApprovalAt', 0) >= get(/databases/$(database)/documents/app_settings/stat_updates).data.round.openedAt);
    }

    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentRole() {
      return currentProfile().data.role;
    }

    function isOwner() {
      return signedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && currentRole() == 'owner')
        || request.auth.uid in ['APsCZzEI4tYdx5UfHuY5Sw10L8B3', 'rbgWddfwUeQiCr5CE3eRD8ZPdZB2']
        || (request.auth.token.email != null && request.auth.token.email in ['656c6f6e69@auth.k7-clan.local', 'tinnakornid2@gmail.com'])
      );
    }

    function isAdminOrOwner() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && currentRole() in ['owner', 'admin']);
    }

    function isActiveUser() {
      return isOwner() || (signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && currentProfile().data.status == 'active');
    }

    function canManageUser(targetRole) {
      return (isOwner() && targetRole != 'owner')
        || (currentRole() == 'admin' && targetRole in ['party_leader', 'member']);
    }

    function validUser(data) {
      return data.keys().hasOnly([
          'id', 'username', 'inGameName', 'powerLevel', 'clan',
          'characterClass', 'classes', 'level', 'legendClasses',
          'legendAgathions', 'role', 'status', 'createdAt', 'lastLoginAt',
          'pendingPowerLevel', 'pendingPowerLevelRequestedAt', 'stats',
          'spiritEnhancements', 'pendingStats', 'pendingSpiritEnhancements',
          'pendingClasses', 'pendingLevel', 'pendingLegendClasses',
          'pendingLegendAgathions', 'pendingStatScreenshotUrl',
          'statScreenshotUrl', 'statRejectionReason', 'statRejectionAt',
          'statApprovalAt', 'approvedStatRequestAt',
          'lastStatUpdatedAt', 'verified', 'statHistory', 'screenshots',
          'screenshotUrl', 'spirits', 'kain7Id', 'updatedAt'
        ])
        && data.keys().hasAll([
          'id', 'username', 'inGameName', 'powerLevel', 'clan',
          'role', 'status', 'createdAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string
        && data.username.matches('^[A-Za-z0-9._-]{3,40}$')
        && data.inGameName is string && data.inGameName.size() >= 1 && data.inGameName.size() <= 60
        && data.powerLevel is number && data.powerLevel >= 0 && data.powerLevel <= 1000000000
        && data.clan is string && data.clan.size() <= 60
        && data.role in ['owner', 'admin', 'party_leader', 'member']
        && data.status in ['active', 'pending_approval']
        && data.createdAt is number && data.createdAt > 0
        && (!('pendingPowerLevel' in data) || data.pendingPowerLevel == null
          || (data.pendingPowerLevel is number && data.pendingPowerLevel >= 0
            && data.pendingPowerLevel <= 1000000000))
        && (!('pendingPowerLevelRequestedAt' in data) || data.pendingPowerLevelRequestedAt == null
          || (data.pendingPowerLevelRequestedAt is number && data.pendingPowerLevelRequestedAt > 0))
        && (!('pendingStats' in data) || data.pendingStats == null
          || (data.pendingStats is map && data.pendingStats.size() <= 100))
        && (!('pendingSpiritEnhancements' in data) || data.pendingSpiritEnhancements == null
          || (data.pendingSpiritEnhancements is map && data.pendingSpiritEnhancements.size() <= 50))
        && (!('pendingClasses' in data) || data.pendingClasses == null
          || (data.pendingClasses is list && data.pendingClasses.size() <= 20))
        && (!('pendingLevel' in data) || data.pendingLevel == null
          || (data.pendingLevel is number && data.pendingLevel >= 0 && data.pendingLevel <= 100))
        && (!('pendingLegendClasses' in data) || data.pendingLegendClasses == null
          || (data.pendingLegendClasses is number && data.pendingLegendClasses >= 0
            && data.pendingLegendClasses <= 1000))
        && (!('pendingLegendAgathions' in data) || data.pendingLegendAgathions == null
          || (data.pendingLegendAgathions is number && data.pendingLegendAgathions >= 0
            && data.pendingLegendAgathions <= 1000))
        && (!('pendingStatScreenshotUrl' in data) || data.pendingStatScreenshotUrl == null
          || (data.pendingStatScreenshotUrl is string
            && data.pendingStatScreenshotUrl.size() <= 1000000));
    }

    function validNewMember(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.role == 'member'
        && request.resource.data.status == 'pending_approval'
        && request.resource.data.powerLevel == 0
        && !('password' in request.resource.data);
    }

    function validSelfUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'inGameName', 'pendingPowerLevel', 'pendingPowerLevelRequestedAt',
          'pendingStats', 'pendingSpiritEnhancements', 'pendingClasses',
          'pendingLevel', 'pendingLegendClasses', 'pendingLegendAgathions',
          'pendingStatScreenshotUrl', 'statRejectionReason', 'statRejectionAt',
          'statHistory', 'updatedAt'
        ])
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.powerLevel == resource.data.powerLevel
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validPrivilegedUserUpdate() {
      return request.resource.data.id == resource.data.id
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && canManageUser(resource.data.role)
        && ((isOwner() && request.resource.data.role in ['admin', 'party_leader', 'member'])
          || request.resource.data.role == resource.data.role);
    }

    match /system/{docId} {
      allow read: if true;
      allow write: if isAdminOrOwner();
    }

    match /users/{userId} {
      allow create: if (isOwner() && validUser(request.resource.data))
        || (validUser(request.resource.data) && validNewMember(userId));
      allow read: if true;
      allow update: if validUser(request.resource.data)
        && signedIn()
        // New submissions must pass the central duplicate/screenshot validator.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingPowerLevelRequestedAt', 'pendingStats', 'pendingSpiritEnhancements', 'pendingClasses', 'pendingLevel', 'pendingLegendClasses', 'pendingLegendAgathions', 'pendingPowerLevel', 'pendingStatScreenshotUrl'])
          || (request.resource.data.get('pendingPowerLevelRequestedAt', null) == null && request.resource.data.get('pendingPowerLevel', null) == null))
        && (
          (isOwner() && (
            (resource.data.role == 'owner' && request.auth.uid == userId && request.resource.data.role == 'owner')
            || (resource.data.role != 'owner' && request.resource.data.role in ['admin', 'party_leader', 'member'])
          ))
          || validPrivilegedUserUpdate()
          || (request.auth.uid == userId && validSelfUpdate())
        );
      allow delete: if signedIn()
        && request.auth.uid != userId
        && canManageUser(resource.data.role);
    }

    match /items/{itemId} {
      allow read: if true;
      allow create: if isAdminOrOwner() && (!roundEnforced() || (request.resource.data.get('claimants', []).size() == 0 && request.resource.data.get('distributedTo', null) == null));
      allow delete: if isAdminOrOwner();
      // Member claims are written to item_claims and mirrored by the authenticated API.
      allow update: if isAdminOrOwner() && (!roundEnforced() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['claimants', 'distributedTo', 'status']));
    }

    match /item_claims/{claimId} {
      allow read: if true;
      allow create: if signedIn()
        && roundEligible()
        && request.resource.data.keys().hasOnly([
          'itemId', 'userId', 'inGameName', 'clan', 'powerLevel', 'claimedAt'
        ])
        && request.resource.data.keys().hasAll([
          'itemId', 'userId', 'inGameName', 'clan', 'powerLevel', 'claimedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.inGameName == currentProfile().data.inGameName
        && request.resource.data.clan == currentProfile().data.clan
        && request.resource.data.powerLevel == currentProfile().data.powerLevel
        && claimId == request.resource.data.itemId + '__' + request.auth.uid
        && exists(/databases/$(database)/documents/items/$(request.resource.data.itemId))
        && (!('status' in get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data)
            || get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.status == 'available')
        && isActiveUser()
        && request.resource.data.itemId is string
        && request.resource.data.claimedAt is number;
      allow update: if false;
      allow delete: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdminOrOwner());
    }

    match /item_queues/{queueId} {
      allow read: if true;
      allow create: if isAdminOrOwner() && (!roundEnforced() || request.resource.data.get('queueList', []).size() == 0);
      allow delete: if isAdminOrOwner();
      // Member queue changes are scoped and persisted by the authenticated relay API.
      allow update: if isAdminOrOwner() && (!roundEnforced() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['queueList']));
    }

    match /quick_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrOwner();
    }

    function validGeneralItem(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && (!('imageUrl' in data) || data.imageUrl is string)
        && data.price is number && data.price >= 0 && data.price <= 1000000000
        && data.quantity is number && data.quantity >= 0 && data.quantity <= 1000000
        && data.minPowerLevel is number && data.minPowerLevel >= 0 && data.minPowerLevel <= 1000000000
        && data.rarity in ['RARE', 'EPIC', 'LAGEND', 'MYTHIC', 'LEGEND']
        && (!('queueList' in data) || data.queueList is list)
        && (!('receiptHistory' in data) || data.receiptHistory is list)
        && (!('maxRequestQuantity' in data) || (data.maxRequestQuantity is number && data.maxRequestQuantity >= 0))
        && (!('isCraftGoal' in data) || data.isCraftGoal is bool)
        && (!('allowMemberQueue' in data) || data.allowMemberQueue is bool)
        && (!('receiptPolicy' in data) || (data.receiptPolicy is string && data.receiptPolicy.size() <= 40))
        && (!('isPinned' in data) || data.isPinned is bool)
        && (!('sortOrder' in data) || data.sortOrder is number)
        && (!('updatedAt' in data) || (data.updatedAt is number && data.updatedAt >= 0))
        && data.createdAt is number && data.createdAt > 0;
    }

    match /general_items/{itemId} {
      allow read: if true;
      allow create: if isAdminOrOwner()
        && (!roundEnforced() || (request.resource.data.get('queueList', []).size() == 0 && request.resource.data.get('receiptHistory', []).size() == 0))
        && request.resource.data.id == itemId
        && validGeneralItem(request.resource.data);
      allow delete: if isAdminOrOwner();
      allow update: if validGeneralItem(request.resource.data)
        && (!roundEnforced() || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['queueList', 'receiptHistory']))
        && request.resource.data.id == resource.data.id
        && isAdminOrOwner();
    }

    match /clans/{clanId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrOwner();
    }

    match /diamond_vault/{recordId} {
      allow read: if true;
      allow create, update, delete: if isAdminOrOwner();
    }

    match /app_settings/{settingId} {
      allow read: if settingId != 'gemini_ai' || isOwner();
      allow create, update: if (settingId == 'background' && isOwner())
        || (settingId == 'gemini_ai' && isOwner())
        || (settingId == 'stat_updates' && isOwner())
        || (!(settingId in ['background', 'gemini_ai', 'stat_updates']) && isAdminOrOwner());
      allow delete: if isOwner();
    }

    match /system_meta/{metaId} {
      allow read: if true;
      allow write: if isOwner()
        || (metaId == 'version_hub' && request.resource.data.keys().hasOnly([
            'vaultVersion', 'usersVersion', 'queuesVersion', 'quickItemsVersion',
            'generalItemsVersion', 'clansVersion', 'diamondsVersion', 'settingsVersion',
            'lastUpdatedAt', 'lastUpdatedBy', 'lastChangeType'
          ]));
    }

    match /user_notifications/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn() && (request.auth.uid == userId || isAdminOrOwner());
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
