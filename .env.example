# Local development / การพัฒนาบนเครื่อง
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=

# Vercel backend authentication / การตรวจสิทธิ์ Backend บน Vercel
# Store the complete Firebase service-account JSON as one environment value.
# บันทึก JSON ของ Firebase service account ทั้งชุดเป็น Environment Variable หนึ่งค่า
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=hybrid-box-753bd.firebasestorage.app
